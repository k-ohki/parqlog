[Unit]
Description=parqlog 時系列データサービス
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parqlog
Group=parqlog
ExecStart=/usr/local/bin/parqlog run --config /etc/parqlog/parqlog.toml
Restart=on-failure
RestartSec=5
# 停止時はバッファを書き切ってからチェックポイントする
TimeoutStopSec=60
LimitNOFILE=65536
# データフォルダ以外は書けないようにする
ProtectSystem=strict
ReadWritePaths=/var/lib/parqlog /etc/parqlog
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
